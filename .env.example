# URL base de la API que usa el navegador.
# En desarrollo se deja en /api: Vite reenvía esas peticiones a VITE_BACKEND_URL.
# En producción, apunta al origen público del backend (y agréguelo a
# APP_CORS_ALLOWED_ORIGINS del backend), p. ej. https://api.deportes.unimagdalena.edu.co
VITE_API_URL=/api

# Backend Spring Boot al que reenvía el proxy de desarrollo de Vite.
VITE_BACKEND_URL=http://localhost:8080

# Simulación exclusivamente en el navegador, independiente de POST /dev/login.
# Solo el valor exacto true la activa. Reinicie Vite después de cambiar variables.
# Todas las variables VITE_* son públicas; nunca incluya secretos.
VITE_DEMO_LOGIN=false
